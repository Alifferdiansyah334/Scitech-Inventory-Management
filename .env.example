# Server-only configuration. Never pass private keys to Flutter.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-KEY
APP_SESSION_SECRET=REPLACE-WITH-A-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
BREVO_API_KEY=YOUR-BREVO-API-KEY
BREVO_SENDER_EMAIL=no-reply@your-verified-domain.com
BREVO_SENDER_NAME=SIMS
# Exact trusted browser origins, only when Flutter uses a different origin.
ALLOWED_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
